body {
    width: 100%;
    height: 100%;
    margin: 0;
    font-size: 16px;

    font-family: GAMERIA;
    color: white;
}

#title {
    position: absolute;

    width: 400px;
    height: 100%;

    right: 0%;
    top: 0%;

    padding: 25px;

    text-align: center;
    background-color: #18202e;
    border-color: #3567a5;
    border-width: 5px;
}

button {
    width: 250px;
    height: 55px;

    color: white;
    background-color: #3567a5;
}