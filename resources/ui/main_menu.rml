<rml>

    <head>
        <title>Main Menu</title>
        <link type="text/rcss" href="main_menu.rcss" />
    </head>

    <body>
        <div id="Buy-Menu">
            <h1 id="title">Clicker Game</h1>

            <tabset id="upgrade-tabs">
                <tab>General</tab>
                <panel>
                    <h2>General Upgrades</h2>

                    <div id="general-upgrade-list" data-model="upgrade_model">
                        <div class="upgrade" data-for="upgrade, index : generalUpgrades">
                            <div class="upgradeImage">
                                <img class="upgradePicture" data-attr-src="upgrade.image" />
                            </div>

                            <div class="upgradeText">
                                <p>Name: {{ upgrade.name }}</p>
                                <p>Quantity: {{ upgrade.quantity }}</p>
                                <p>Description: {{ upgrade.description }}</p>
                                <p>Price: {{ upgrade.price }}</p>
                            </div>

                            <div class="upgradeButton">
                                <button data-event-click="buy_general_upgrade(index)">
                                    Buy Item
                                </button>
                            </div>
                        </div>
                    </div>
                </panel>

                <tab>Clicking</tab>
                <panel>
                    <h2>Click Upgrades</h2>
                    <div id="click-upgrade-list" data-model="upgrade_model">
                        <div class="upgrade" data-for="upgrade, index : clickUpgrades">
                            <div class="upgradeImage">
                                <img class="upgradePicture" data-attr-src="upgrade.image" />
                            </div>

                            <div class="upgradeText">
                                <p>Name: {{ upgrade.name }}</p>
                                <p>Quantity: {{ upgrade.quantity }}</p>
                                <p>Description: {{ upgrade.description }}</p>
                                <p>Price: {{ upgrade.price }}</p>
                            </div>

                            <div class="upgradeButton">
                                <button data-event-click="buy_click_upgrade(index)">
                                    Buy Item
                                </button>
                            </div>
                        </div>
                    </div>
                </panel>

                <tab>Bubbles</tab>
                <panel>
                    <h2>Bubble Upgrades</h2>
                    <div id="bubble-upgrade-list" data-model="upgrade_model">
                        <div class="upgrade" data-for="upgrade, index : bubbleUpgrades">
                            <div class="upgradeImage">
                                <img class="upgradePicture" data-attr-src="upgrade.image" />
                            </div>

                            <div class="upgradeText">
                                <p>Name: {{ upgrade.name }}</p>
                                <p>Quantity: {{ upgrade.quantity }}</p>
                                <p>Description: {{ upgrade.description }}</p>
                                <p>Price: {{ upgrade.price }}</p>
                            </div>

                            <div class="upgradeButton">
                                <button data-event-click="buy_bubble_upgrade(index)">
                                    Buy Item
                                </button>
                            </div>
                        </div>
                    </div>
                </panel>
            </tabset>
        </div>
    </body>
</rml>