<rml>

    <head>
        <title>Main Menu</title>
        <link type="text/rcss" href="main_menu.rcss" />
    </head>

    <body>
        <div id="Buy-Menu">
            <h1 id="title">Clicker Game</h1>

            <tabset id="upgrade-tabs">
                <tab>General</tab>
                <panel>
                    <h2>General Upgrades</h2>
                    <div class="upgrade">
                        <div class="upgradeImage">
                            <img src="circle.tga" class="upgradePicture"></img>
                        </div>
                        <div class="upgradeText">
                            <p>Name:</p>
                            <p>Quantity:</p>
                            <p>Description:</p>
                        </div>
                        <div class="upgradeButton">
                            <button>BuyItem</button>
                        </div>

                    </div>
                </panel>

                <tab>Clicking</tab>
                <panel>
                    <h2>Click Upgrades</h2>
                    <p>Welcome to the click upgrades tab!</p>
                </panel>

                <tab>Bubbles</tab>
                <panel>
                    <h2>Bubble Upgrades</h2>
                    <p>Welcome to the bubble upgrades tab!</p>
                </panel>
            </tabset>
        </div>
    </body>
</rml>