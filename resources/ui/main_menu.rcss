div,
h1,
h2,
h3,
h4,
h5,
h6,
p,
hr,
pre,
tabset tabs {
    display: block;
}

h1 {
    font-size: 2em;
    margin: .67em 0;
}

h2 {
    font-size: 1.5em;
    margin: .75em 0;
}

h3 {
    font-size: 1.17em;
    margin: .83em 0;
}

h4,
p {
    margin: 1.12em 0;
}

h5 {
    font-size: .83em;
    margin: 1.5em 0;
}

h6 {
    font-size: .75em;
    margin: 1.67em 0;
}

h1,
h2,
h3,
h4,
h5,
h6,
strong {
    font-weight: bold;
}

em {
    font-style: italic;
}

pre {
    white-space: pre;
}

hr {
    border-width: 1px;
}

table {
    box-sizing: border-box;
    display: table;
}

tr {
    box-sizing: border-box;
    display: table-row;
}

td {
    box-sizing: border-box;
    display: table-cell;
}

col {
    box-sizing: border-box;
    display: table-column;
}

colgroup {
    display: table-column-group;
}

thead,
tbody,
tfoot {
    display: table-row-group;
}


body {
    width: 100vw;
    height: 100vh;
    margin: 0;

    font-family: Roboto;
    font-size: 25px;
    color: white;
}

#Buy-Menu {
    position: absolute;
    box-sizing: border-box;

    width: 30vw;
    height: 100vh;

    top: 0;
    right: 0;

    padding-right: 2vw;
    padding-left: 2vw;

    padding-bottom: 2vh;
    padding-top: 2vh;



    text-align: center;
    background-color: transparent;
    decorator: image("MainPanelbackground.tga") border-box;
}

#title {
    display: block;
    box-sizing: border-box;

    width: 100%;
    margin: 1vh 0 1vh 0;
    padding-top: 4vh;

    color: white;
}

#upgrade-tabs {
    display: block;
    box-sizing: border-box;
    width: 100%;

    background-color: #eec0ff;
    border-radius: 30px;
    font-size: 1.5vw;



}

#upgrade-tabs tabs {
    display: block;
    box-sizing: border-box;

    width: 100%;
    height: 65px;
    padding-top: 20px;

    white-space: nowrap;


}

#upgrade-tabs tab {
    display: inline-block;
    box-sizing: border-box;

    width: 25%;
    height: 55px;
    padding: 10px 2px;
    margin-left: 10px;
    border-radius: 10px;

    color: white;
    background-color: #db7ffc;
    text-align: center;

}

#upgrade-tabs tab:hover {
    background-color: #9036b1;
}

#upgrade-tabs tab:active {
    background-color: #e491ff;
}

#upgrade-tabs panels {
    display: block;
    box-sizing: border-box;

    width: 100%;
    margin-top: 15px;
}

#upgrade-tabs panel {
    display: block;
    box-sizing: border-box;

    width: 100%;
    height: 60vh;
    padding: 20px;

    overflow-x: hidden;
    overflow-y: auto;
    border-bottom-left-radius: 30px;
    border-bottom-right-radius: 30px;

    text-align: left;
    white-space: normal;

    background-color: #d86dff;
}

#upgrade-tabs panel h2 {
    display: block;
    width: auto;
    margin: 0 0 0 0;

    text-align: center;
}

#upgrade-tabs panel p {
    display: block;
    width: auto;
    margin: 0 0 12px 0;

    white-space: normal;
}

.line {
    border-bottom: 1px #ffffff;
    margin-top: 15px;
    margin-bottom: 30px;
}

.upgrade {
    display: flex;
    font: 10px;
    color: white;
    background-color: #560075;
    border-width: 2px;
    border-radius: 20px;
    border-color: #e491ff;
    margin-bottom: 10px;
}

.upgradeImage {
    width: 20%;
    height: auto;
    overflow: hidden;
    padding-top: 2vh;
}

.upgradeImage img {
    width: 100%;
    height: auto;
}

.upgradeText {
    width: 60%;
    font-family: Roboto;
    margin-top: 1vh;
    margin-left: 0.2vw;
    font-size: 0.8vw;
}

.upgradeText p {
    width: 100%;
    margin-top: 1vh;
    margin-bottom: 0.2vh;
    height: auto;
}

.upgradeButton {
    width: 20%;
    font: 20px;
    display: flex;
    text-align: center;
    justify-content: center;
    align-items: center;
    font-family: Roboto;
}

.upgradeButton button {
    box-sizing: border-box;

    width: 90%;
    min-width: 0;

    padding: 5px;

    font-family: Roboto;
    font-size: 1.2vw;
    border-radius: 20px;

    color: white;
    background-color: #db7ffc;
}

.upgradeButton button:hover {
    background-color: #9036b1;
}

.upgradeButton button:active {
    background-color: #e491ff;
}

button {
    box-sizing: border-box;
    color: white;
    background-color: #3567a5;
}

scrollbarvertical {
    margin: 0;
    padding: 0;
    position: absolute;
    width: 0px;
}


scrollbarvertical sliderarrowdec,
scrollbarvertical sliderarrowinc {
    width: 0;
    height: 0;
}

scrollbarvertical slidertrack {
    width: 30px;
    margin-left: 0;

    background-color: #111822;
}

scrollbarvertical sliderbar {
    width: 23px;
    min-height: 30px;
    margin-left: 2px;

    background-color: #3567a5;
}